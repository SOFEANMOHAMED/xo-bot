# ============================================
# ملف إعدادات البيئة للـ Frontend (Production)
# ============================================
# انسخ هذا الملف إلى .env واملأ القيم الفعلية
# cp .env.production.example .env
# nano .env
# ============================================

# ============================================
# إعدادات API
# ============================================
# عنوان Backend API (يجب أن يكون HTTPS في الإنتاج)
# يجب أن يطابق BACKEND_URL في backend/.env
VITE_API_URL=https://api.xo-bot.com/api

# ============================================
# ملاحظات مهمة:
# ============================================
# 1. تأكد من أن VITE_API_URL يطابق BACKEND_URL في backend/.env
# 2. يجب أن يستخدم HTTPS في الإنتاج
# 3. بعد تغيير هذا الملف، يجب إعادة بناء التطبيق:
#    npm run build
# ============================================
