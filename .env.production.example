# ============================================
# ملف إعدادات البيئة للـ Frontend (Production)
# ============================================
# انسخ هذا الملف إلى .env واملأ القيم الفعلية
# cp .env.production.example .env
# nano .env
# ============================================

# ============================================
# إعدادات API
# ============================================
# عنوان Backend API (يجب أن يكون HTTPS في الإنتاج)
# يجب أن يطابق BACKEND_URL في backend/.env
VITE_API_URL=https://api.xo-bot.com/api

# ============================================
# لوحة السوبر أدمن (رابط سري)
# ============================================
# مسار الواجهة السري (بدون /admin). غيّره عند الحاجة ثم أعد البناء.
VITE_ADMIN_BASE_PATH=/ops-change-me-to-a-random-path
# ADMIN_GATE_SECRET يعيش في backend/.env فقط — يُدخَل يدوياً عند فتح اللوحة (كوكي HttpOnly)

# ============================================
# ملاحظات مهمة:
# ============================================
# 1. تأكد من أن VITE_API_URL يطابق BACKEND_URL في backend/.env
# 2. يجب أن يستخدم HTTPS في الإنتاج
# 3. بعد تغيير هذا الملف، يجب إعادة بناء التطبيق:
#    npm run build
# 4. افتح اللوحة عبر: https://your-domain{VITE_ADMIN_BASE_PATH}/overview
# 5. عند الدخول: أدخل ADMIN_GATE_SECRET مرة واحدة لكل جلسة متصفح
# ============================================
