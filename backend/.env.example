DB_HOST=localhost
DB_PORT=5432
DB_NAME=almusaid_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=
# OpenAI — required for sales AI + inbound voice transcription (STT)
OPENAI_API_KEY=
# Voice STT: gpt-transcribe (primary) with automatic whisper-1 fallback
# VOICE_STT_MODEL=gpt-transcribe
# VOICE_STT_FALLBACK_MODEL=whisper-1
# WHISPER_MAX_BYTES=15728640

# Comma-separated origins are NOT parsed by cors() as a list — use one origin or implement an allowlist callback
CORS_ORIGIN=https://xo-bot.com
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SUPER_ADMIN_NAME=Super Admin
AI_MAX_PRODUCTS_CONTEXT=40
AI_MAX_SERVICES_CONTEXT=20
# Must match value entered in admin unlock UI (NOT a VITE_* frontend env)
ADMIN_GATE_SECRET=change-me-to-a-long-random-secret

# Web Push (PWA) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
