# ============================================
# ملف إعدادات البيئة للإنتاج (Production)
# ============================================
# انسخ هذا الملف إلى .env واملأ القيم الفعلية
# cp .env.production.example .env
# nano .env
# ============================================

# ============================================
# إعدادات الخادم الأساسية
# ============================================
NODE_ENV=production
PORT=3001

# ============================================
# إعدادات قاعدة البيانات PostgreSQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xobot_db
DB_USER=xobot_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ============================================
# إعدادات الأمان (JWT)
# ============================================
# مهم جداً: استخدم مفتاح عشوائي قوي (32 حرف على الأقل)
# يمكنك إنشاؤه باستخدام: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
JWT_EXPIRES_IN=7d

# ============================================
# إعدادات CORS و URLs
# ============================================
# عنوان Frontend (يجب أن يكون HTTPS في الإنتاج)
CORS_ORIGIN=https://xo-bot.com

# عنوان Backend الكامل (يجب أن يكون HTTPS)
# مهم جداً لربط Telegram و Webhooks
BACKEND_URL=https://xo-bot.com/api

# عنوان Frontend (لروابط الإيميلات)
FRONTEND_URL=https://xo-bot.com

# ============================================
# إعدادات Gemini AI
# ============================================
# احصل على المفتاح من: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=CHANGE_ME_YOUR_GEMINI_API_KEY

# حدود السياق (اختياري - لتحسين التكلفة)
AI_MAX_PRODUCTS_CONTEXT=40
AI_MAX_SERVICES_CONTEXT=20

# ============================================
# إعدادات البريد الإلكتروني (Mailgun HTTP API)
# ============================================
# يُفضَّل Mailgun API عبر HTTPS (منافذ SMTP الصادرة غالباً محظورة على VPS)
MAILGUN_API_KEY=your-mailgun-private-api-key
MAILGUN_DOMAIN=xo-bot.com
MAILGUN_API_BASE=https://api.mailgun.net
SMTP_FROM="Xo Bot <noreply@xo-bot.com>"

# SMTP احتياطي (اختياري)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@xo-bot.com
# SMTP_PASS=your-smtp-password

# ============================================
# إعدادات Telegram Bot
# ============================================
# اختياري: إذا كنت تريد استخدام Telegram Bot
# احصل على Bot Token من @BotFather على Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-here-optional

# ============================================
# إعدادات Facebook Integration
# ============================================
# اختياري: إذا كنت تريد ربط صفحة Facebook
# احصل على App ID و App Secret من: https://developers.facebook.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your-facebook-webhook-verify-token
FACEBOOK_REDIRECT_URI=https://xo-bot.com/integrations/facebook/callback

# ============================================
# إعدادات Shopify Integration
# ============================================
# اختياري: إذا كنت تريد ربط متجر Shopify
# احصل على API Key و Secret من: https://partners.shopify.com
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_REDIRECT_URI=https://xo-bot.com/integrations/shopify/callback

# ============================================
# إعدادات WhatsApp Business
# ============================================
# اختياري: إذا كنت تريد ربط WhatsApp Business
# اختياري: App Secret للتحقق من توقيع WhatsApp (أو استخدم FACEBOOK_APP_SECRET إن كان نفس تطبيق Meta)
# WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-whatsapp-webhook-verify-token

# تشفير جلسات واتساب ويب (QR). 32 بايت base64:
# openssl rand -base64 32
# إن تُرك فارغاً يُشتق المفتاح من JWT_SECRET
# WHATSAPP_SESSION_ENCRYPTION_KEY=

# ============================================
# إعدادات إضافية
# ============================================
# اسم التطبيق (يستخدم في الإيميلات)
APP_NAME=Xo Bot

# مجلد رفع الملفات
UPLOAD_DIR=uploads

# مجلد السجلات
LOG_DIR=logs

# ============================================
# إعدادات Super Admin (اختياري)
# ============================================
# يمكنك إنشاء حساب Super Admin باستخدام هذه القيم
# أو تركها فارغة واستخدام الأوامر الافتراضية
SUPER_ADMIN_EMAIL=admin@xo-bot.com
SUPER_ADMIN_PASSWORD=change-this-strong-password
SUPER_ADMIN_NAME=Super Admin

# ============================================
# بوابة API للسوبر أدمن (يُدخَل في واجهة فتح اللوحة — لا تضعه في VITE_*)
# ============================================
ADMIN_GATE_SECRET=change-me-to-a-long-random-secret

# ============================================
# ملاحظات مهمة:
# ============================================
# 1. تأكد من تغيير جميع القيم التي تحتوي على "your-*" أو "change-this"
# 2. استخدم كلمات مرور قوية وآمنة
# 3. لا تشارك ملف .env مع أي شخص
# 4. تأكد من أن BACKEND_URL و CORS_ORIGIN يستخدمان HTTPS
# 5. في الإنتاج، استخدم SSL Certificate صالح
# 6. احتفظ بنسخة احتياطية من ملف .env في مكان آمن
# 7. مسار لوحة الأدمن السري يُضبط في frontend عبر VITE_ADMIN_BASE_PATH
# ============================================

# ============================================
# Web Push (PWA notifications)
# ============================================
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@xo-bot.com
