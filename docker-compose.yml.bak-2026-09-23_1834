services:
  postgres:
    image: postgres:18
    container_name: xobot-postgres
    restart: unless-stopped
    ports:
      - "5432:5432"
    environment:
      POSTGRES_DB: xobot_db
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    env_file:
      - .env.docker
    volumes:
      - xobot_pgdata:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d xobot_db"]
      interval: 5s
      timeout: 5s
      retries: 20

volumes:
  xobot_pgdata:
